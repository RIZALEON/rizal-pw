{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rizaleon.github.io/rizal-pw/classroom/state/proficiency.schema.json",
  "title": "ЯBOT Classroom proficiency view (v1, generated)",
  "description": "GENERATED by tools/classroom.py build into views/proficiency.json. Never hand-edited and never a source of truth: it is derived from scores/ in order (scored_at, then file name; superseded scores are dropped). Per lesson per learner, a pass adds 1 to the streak and any fail resets it to 0; proficient at 3 and kept after a later fail. A repeated-prompt pass does not count. Order is the original attempt time (a re-score keeps its place). x-practice scores never count; locked lessons show no streak.",
  "type": "object",
  "required": [
    "schema",
    "generated_by",
    "rule",
    "learners"
  ],
  "properties": {
    "schema": {
      "const": "rbot.classroom.proficiency.v1"
    },
    "generated_by": {
      "const": "classroom/tools/classroom.py build"
    },
    "rule": {
      "type": "object",
      "required": [
        "streak_required",
        "reset_on_fail",
        "retry_prompt",
        "distinct_prompts_in_streak",
        "prelude",
        "prelude_gate"
      ],
      "properties": {
        "streak_required": {
          "const": 3
        },
        "reset_on_fail": {
          "const": true
        },
        "retry_prompt": {
          "const": "different"
        },
        "distinct_prompts_in_streak": {
          "const": true
        },
        "prelude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prelude_gate": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "learners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "rid",
          "enrolled",
          "status",
          "proficient_count",
          "lesson_count",
          "next_lesson",
          "lessons"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "rid": {
            "type": [
              "string",
              "null"
            ]
          },
          "enrolled": {
            "type": "boolean"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "teacher": {
            "type": [
              "string",
              "null"
            ]
          },
          "scorers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proficient_count": {
            "type": "integer",
            "minimum": 0
          },
          "lesson_count": {
            "type": "integer",
            "minimum": 0
          },
          "next_lesson": {
            "type": [
              "string",
              "null"
            ]
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "lesson_id",
                "state",
                "streak",
                "passes",
                "fails",
                "proficient",
                "last_exercise_id",
                "prompts_in_streak",
                "history",
                "practice"
              ],
              "properties": {
                "lesson_id": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "locked",
                    "open",
                    "in_progress",
                    "proficient"
                  ]
                },
                "streak": {
                  "type": "integer",
                  "minimum": 0
                },
                "passes": {
                  "type": "integer",
                  "minimum": 0
                },
                "fails": {
                  "type": "integer",
                  "minimum": 0
                },
                "proficient": {
                  "type": "boolean"
                },
                "proficient_since": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_exercise_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "prompts_in_streak": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "history": {
                  "type": "string",
                  "description": "P/F per scored attempt, oldest first; '·' when none."
                },
                "practice": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "x-practice scores on this lesson (never counted)."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
