{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rizaleon.github.io/rizal-pw/classroom/state/bridge-revocation.schema.json",
  "title": "ЯBOT Classroom bridge revocation / demotion (v1, proposal)",
  "description": "One append-only file in bridge/revocations/, named <revocation_id>.json. Written only by a member teacher or the Decider, approved by the Decider, effective when the Decider merges it. Revokes a certificate (demoting at least one level) or the whole guest id. Old records stay as history.",
  "type": "object",
  "required": ["schema", "revocation_id", "guest_id", "scope", "reason", "evidence", "new_level", "filed_by", "decider_approval", "revoked_at"],
  "properties": {
    "schema": { "const": "rbot.classroom.bridge-revocation.v1" },
    "revocation_id": { "type": "string", "pattern": "^REV-GID-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{4}-[0-9]{8}T[0-9]{6}Z$", "description": "REV-<guest_id>-<revoked_at compact UTC>; equals the file name." },
    "guest_id": { "type": "string", "pattern": "^GID-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{4}$" },
    "scope": { "enum": ["certificate", "guest_id"], "description": "guest_id: the GID itself is revoked; no new envelopes are accepted." },
    "certificates": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^GID-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{4}-(tutor|guest-teacher)-[0-9]{1,3}$" } },
    "reason": { "enum": ["safety_zero", "spoofed_identity", "leaked_secret", "scoring_collusion", "expired_no_recert", "other"] },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,160}$" } },
    "new_level": { "enum": ["guest", "tutor", "none"], "description": "Level after this record: at least one below the revoked one; none when scope is guest_id." },
    "filed_by": {
      "type": "object", "required": ["rid", "name"],
      "properties": { "rid": { "type": "string", "pattern": "^ЯID-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{4}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 64 } },
      "additionalProperties": false
    },
    "decider_approval": {
      "type": "object", "required": ["message_id", "rid", "name"],
      "properties": { "message_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" }, "rid": { "const": "ЯID-0001-3QQS" }, "name": { "const": "Rizal" } },
      "additionalProperties": false
    },
    "revoked_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "notes": { "type": "string", "maxLength": 500, "pattern": "^[^\\n\\r]*$" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "scope": { "const": "certificate" } } }, "then": { "required": ["certificates"], "properties": { "new_level": { "enum": ["guest", "tutor"] } } } },
    { "if": { "properties": { "scope": { "const": "guest_id" } } }, "then": { "properties": { "new_level": { "const": "none" } } } }
  ]
}
