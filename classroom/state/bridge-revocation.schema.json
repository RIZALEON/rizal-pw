{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rizaleon.github.io/rizal-pw/classroom/state/bridge-revocation.schema.json",
  "title": "ЯBOT Classroom bridge revocation / demotion (v1, proposal)",
  "description": "One append-only file in bridge/revocations/.",
  "type": "object",
  "required": ["schema", "revocation_id", "guest_id", "scope", "reason", "evidence", "new_level", "filed_by", "decider_approval", "revoked_at"],
  "properties": {
    "schema": { "const": "rbot.classroom.bridge-revocation.v1" },
    "revocation_id": { "type": "string", "pattern": "^REV-GID-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{4}-[0-9]{8}T[0-9]{6}Z$" },
    "guest_id": { "type": "string", "pattern": "^GID-[0-9]{4}-[0-9A-HJKMNP-TV-Z]{4}$" },
    "scope": { "enum": ["certificate", "guest_id"] },
    "certificates": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
    "reason": { "enum": ["safety_zero", "spoofed_identity", "leaked_secret", "scoring_collusion", "expired_no_recert", "other"] },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string" } },
    "new_level": { "enum": ["guest", "tutor", "none"] },
    "filed_by": {
      "type": "object", "required": ["rid", "name"],
      "properties": { "rid": { "type": "string" }, "name": { "type": "string" } },
      "additionalProperties": false
    },
    "decider_approval": {
      "type": "object", "required": ["message_id", "rid", "name"],
      "properties": { "message_id": { "type": "string" }, "rid": { "const": "ЯID-0001-3QQS" }, "name": { "const": "Rizal" } },
      "additionalProperties": false
    },
    "revoked_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 500 }
  },
  "additionalProperties": false
}
