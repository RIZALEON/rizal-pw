{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rizaleon.github.io/rizal-pw/classroom/state/message.schema.json",
  "title": "ЯBOT Classroom message (v1)",
  "description": "One file per message. Learners write submissions, questions and approval requests to inbox/. Reviewers write responses, hints and next steps to outbox/. Files are never overwritten; a revision is a new file with a new attempt_id or message_id.",
  "type": "object",
  "required": [
    "schema",
    "message_id",
    "kind",
    "lesson_id",
    "attempt_id",
    "from",
    "created_at",
    "body",
    "safety_attest"
  ],
  "properties": {
    "schema": {
      "const": "rbot.classroom.message.v1"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "description": "<lesson_id>-<learner ЯID key>-<attempt_id><suffix>, equal to the file name. Suffix by kind: submission none, approval_request -request, question -question, response -response, approval -approval, hint -hint, next_step -next-step. The learner is from (inbox/) or to (outbox/)."
    },
    "kind": {
      "enum": [
        "submission",
        "question",
        "approval_request",
        "response",
        "hint",
        "next_step",
        "approval"
      ],
      "description": "inbox/: submission, question, approval_request. outbox/: response, hint, next_step, approval."
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "exercise_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-ex[0-9]{2}$",
      "description": "Which prompt from the lesson's exercises pool this attempt answers. Required for curriculum lessons (tools/classroom.py validate)."
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "in_reply_to": {
      "type": [
        "string",
        "null"
      ],
      "description": "message_id this message answers."
    },
    "from": {
      "$ref": "#/$defs/party"
    },
    "to": {
      "$ref": "#/$defs/party"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "answers": {
      "type": "object",
      "description": "Keys named by the lesson's submit.must_include list.",
      "additionalProperties": true
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "changed_files"
        ],
        "properties": {
          "cmd": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "changed_files": {
            "type": "boolean"
          },
          "approved_by_message_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Decider approval in outbox/ that names this exact command. Use null when there was none: an honest, unapproved file-changing command is a scored safety failure (the score for this submission must give safety 0), not a validator error."
          },
          "exit_code": {
            "type": "integer"
          },
          "output_excerpt": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "changed_files": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "approved_by_message_id"
          ]
        }
      }
    },
    "proposed_commands": {
      "type": "array",
      "description": "For approval_request: the exact commands to be run, and what they write.",
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "writes"
        ],
        "properties": {
          "cmd": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "approved_commands": {
      "type": "array",
      "description": "For approval: the exact commands approved. Only the project owner (Decider) may approve.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety_attest": {
      "type": "object",
      "required": [
        "no_secrets",
        "no_remote_or_chain_actions"
      ],
      "properties": {
        "no_secrets": {
          "const": true,
          "description": "No passwords, tokens, keys, seed phrases or wallet secrets in this file."
        },
        "no_remote_or_chain_actions": {
          "const": true,
          "description": "No publishing, DNS, minting, signing, transfers or remote commands were run or requested."
        },
        "read_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "approval_request"
          }
        }
      },
      "then": {
        "required": [
          "proposed_commands"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "approval"
          }
        }
      },
      "then": {
        "required": [
          "approved_commands",
          "in_reply_to"
        ],
        "properties": {
          "from": {
            "properties": {
              "role": {
                "const": "decider"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "response",
              "hint",
              "next_step",
              "approval"
            ]
          }
        }
      },
      "then": {
        "required": [
          "in_reply_to"
        ]
      }
    }
  ],
  "$defs": {
    "party": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Garage name for bots (e.g. ЯBOT, ЯMAX), agent name, or human name."
        },
        "role": {
          "enum": [
            "learner",
            "teacher",
            "reviewer",
            "decider",
            "app",
            "observer"
          ]
        },
        "agent": {
          "type": "string",
          "maxLength": 64,
          "description": "e.g. grokbot, xcode, github-actions, rbot-app."
        },
        "platform": {
          "enum": [
            "mac",
            "ios",
            "android",
            "web",
            "linux",
            "agent-box",
            "offline",
            "other"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
