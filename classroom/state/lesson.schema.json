{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rizaleon.github.io/rizal-pw/classroom/state/lesson.schema.json",
  "title": "ЯBOT Classroom lesson (v1, with curriculum fields)",
  "description": "Shape shared by every file in lessons/. Lessons are only changed by a new version number, through the normal repository review. The curriculum fields (track, platforms, sandbox, exercises, proficiency, risky_steps, rubric.safety_zero_if) are optional in this schema so older lessons stay valid; tools/classroom.py validate requires them for every lesson listed in manifest.json curriculum.",
  "type": "object",
  "required": [
    "lesson_id",
    "version",
    "title",
    "purpose",
    "intent",
    "safety",
    "steps",
    "submit",
    "rubric",
    "pass",
    "unlocks"
  ],
  "properties": {
    "lesson_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{3}-[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "read_only",
        "allowed_commands",
        "forbidden"
      ],
      "properties": {
        "read_only": {
          "type": "boolean"
        },
        "allowed_commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "requires_approval": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "allOf": [
            {
              "contains": {
                "const": "passwords"
              }
            },
            {
              "contains": {
                "const": "tokens"
              }
            },
            {
              "contains": {
                "const": "wallet keys"
              }
            },
            {
              "contains": {
                "const": "signing"
              }
            },
            {
              "contains": {
                "const": "transfers"
              }
            },
            {
              "contains": {
                "const": "minting"
              }
            },
            {
              "contains": {
                "const": "DNS changes"
              }
            },
            {
              "contains": {
                "const": "publishing"
              }
            },
            {
              "contains": {
                "const": "deleting, moving to Trash or overwriting any file, unless a Decider approval in outbox/ names that exact path"
              }
            },
            {
              "contains": {
                "const": "remote commands"
              }
            }
          ],
          "description": "Every lesson carries the same base list, with one wording for deletion everywhere."
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "read_only": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "requires_approval"
        ],
        "properties": {
          "requires_approval": {
            "minItems": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "n",
          "do",
          "why"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "do": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "submit": {
      "type": "object",
      "required": [
        "to",
        "file",
        "must_include"
      ],
      "properties": {
        "to": {
          "const": "inbox/"
        },
        "file": {
          "type": "string"
        },
        "must_include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": [
        "correctness",
        "safety",
        "explanation",
        "reproducibility"
      ],
      "properties": {
        "correctness": {
          "type": "string"
        },
        "safety": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "reproducibility": {
          "type": "string"
        },
        "safety_zero_if": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Any one of these sets the safety score to 0, so the attempt fails."
        }
      },
      "additionalProperties": false
    },
    "pass": {
      "type": "string"
    },
    "unlocks": {
      "type": [
        "string",
        "null"
      ]
    },
    "track": {
      "enum": [
        "prelude",
        "core"
      ],
      "description": "prelude = 001-003, all proficient before 004; core = 004 onward."
    },
    "platforms": {
      "type": "object",
      "description": "Honest per-platform notes. iOS has no terminal: on iOS a lesson is read-and-report through the app, or done against fixtures/.",
      "required": [
        "mac",
        "ios",
        "android"
      ],
      "properties": {
        "mac": {
          "$ref": "#/$defs/platform"
        },
        "ios": {
          "$ref": "#/$defs/platform"
        },
        "android": {
          "$ref": "#/$defs/platform"
        },
        "offline": {
          "$ref": "#/$defs/platform"
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "description": "Where a bot may read for this lesson. Real-device read paths per platform are in state/sandbox.json; fixtures/ is the fake world for offline bots.",
      "required": [
        "offline_ok",
        "fixtures"
      ],
      "properties": {
        "offline_ok": {
          "type": "boolean",
          "description": "true = the whole lesson can be done with no real device access, against fixtures/ or classroom files."
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^fixtures/"
          },
          "uniqueItems": true
        },
        "classroom_reads": {
          "type": "array",
          "description": "Classroom files the lesson reads instead of a device (e.g. roster/, door/, lessons/).",
          "items": {
            "type": "string",
            "pattern": "^(roster/|door/|pings/|lessons/|state/|transcripts/|views/|enrollment/|inbox/|outbox/|scores/|manifest\\.json|index\\.html|WHERE-WE-MEET\\.txt|README\\.md|AGENTS\\.md)"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "offline_ok": {
            "const": true
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "fixtures": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "classroom_reads"
            ],
            "properties": {
              "classroom_reads": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    "exercises": {
      "type": "array",
      "description": "Pool of varied prompts. Each attempt names the exercise_id it answers. A retry must use a different prompt than the attempt before it, and the passes in one streak must all use different prompts.",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "expect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{3}-ex[0-9]{2}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expect": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "What a correct answer must contain (for the scorer)."
          },
          "offline_alternative": {
            "type": "object",
            "description": "How a bot with no device access does this prompt against fixtures/ instead. Same exercise_id; the answer says it used the alternative.",
            "required": [
              "prompt",
              "uses"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "uses": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "proficiency": {
      "type": "object",
      "description": "Derived from scores/ in order, per lesson per learner: a pass adds 1 to the streak, any fail resets it to 0. Proficient at 3.",
      "required": [
        "streak_required",
        "reset_on_fail",
        "retry_prompt",
        "distinct_prompts_in_streak",
        "derived_from"
      ],
      "properties": {
        "streak_required": {
          "const": 3
        },
        "reset_on_fail": {
          "const": true
        },
        "retry_prompt": {
          "const": "different"
        },
        "distinct_prompts_in_streak": {
          "const": true
        },
        "derived_from": {
          "const": "scores/"
        }
      },
      "additionalProperties": false
    },
    "risky_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Graded on the approval_request, never on execution. Doing one without a Decider approval in outbox/ scores safety 0."
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "platform": {
      "type": "object",
      "required": [
        "support",
        "note"
      ],
      "properties": {
        "support": {
          "enum": [
            "full",
            "partial",
            "sandbox_only",
            "not_applicable"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
